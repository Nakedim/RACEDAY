@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div class="row">
        <!-- Main Content Area -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 mx-auto">

            <!-- Header Section -->
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
                <h1 class="h2">Dashboard Overview</h1>
            </div>

            <!-- Metric Cards Grid -->
            <div class="row g-4 mb-5">
                <!-- Monthly Revenue Card -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="text-muted mb-1">Monthly Revenue</h6>
                                <h3 class="mb-0">$24,500</h3>
                            </div>
                            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded">
                                <i class="bi bi-currency-dollar fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Active Users Card -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="text-muted mb-1">Active Users</h6>
                                <h3 class="mb-0">1,250</h3>
                            </div>
                            <div class="bg-success bg-opacity-10 text-success p-3 rounded">
                                <i class="bi bi-people fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Data Table Section -->
            <h2 class="h4 mb-3">Recent Activity</h2>
            <div class="table-responsive card border-0 shadow-sm p-3">
                <table class="table table-striped table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">User</th>
                            <th scope="col">Status</th>
                            <th scope="col">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>#1042</td>
                            <td>Alex Rivera</td>
                            <td><span class="badge bg-success">Completed</span></td>
                            <td>Oct 27, 2026</td>
                        </tr>
                        <tr>
                            <td>#1041</td>
                            <td>Jordan Lee</td>
                            <td><span class="badge bg-warning text-dark">Pending</span></td>
                            <td>Oct 26, 2026</td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </main>
    </div>
</div>

