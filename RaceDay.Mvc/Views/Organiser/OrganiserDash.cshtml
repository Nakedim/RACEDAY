@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Inject the updated colors into the page scope -->
@section Styles {
    <style>
        :root {
            --primary-lime: #7cb305; /* Brighter prototype green */
            --dark-lime: #5b8c00;
            --sidebar-light: #e6e8eb;
        }

        /* Overriding layout elements for this specific dashboard style */
        .sidebar {
            background-color: var(--sidebar-light) !important;
            color: #333 !important;
        }

            .sidebar .brand-header {
                background-color: var(--primary-lime);
                color: white;
            }

            .sidebar .nav-link {
                color: white !important;
                background-color: var(--primary-lime) !important;
            }

                .sidebar .nav-link:hover {
                    background-color: var(--dark-lime) !important;
                }

        .footer-banner {
            background-color: var(--primary-lime) !important;
        }
    </style>
}

<div class="text-center my-3">
    <div class="text-muted small">Hi, @Model.UserName</div>
</div>

<!-- Large Feature Header Block -->
<div class="row mb-4">
    <div class="col-12">
        <div class="content-block rounded-1 w-100" style="min-height: 280px;">
            <!-- Intended for featured banners, charts, or primary system stats -->
            @RenderSection("FeatureBlockContent", required: false)
        </div>
    </div>
</div>

<!-- Lower Content Tri-Columns -->
<div class="row g-4 mb-5">
    <!-- My Events -->
    <div class="col-lg-4">
        <div class="header-bar text-center py-2 mb-2 rounded-1">My Events</div>
        <div class="content-block p-3 rounded-1 bg-white border">
            @if (Model.Events != null && Model.Events.Any())
            {
                <ul class="list-group list-group-flush">
                    @foreach (var ev in Model.Events)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @ev.Name
                            <span class="badge bg-success rounded-pill">@ev.Date.ToString("MM/dd")</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted text-center pt-4">No events found.</p>
            }
        </div>
    </div>

    <!-- Race Results -->
    <div class="col-lg-4">
        <div class="header-bar text-center py-2 mb-2 rounded-1">Race results</div>
        <div class="content-block p-3 rounded-1 bg-white border">
            <!-- Table content populated via ViewModel -->
        </div>
    </div>

    <!-- My Race -->
    <div class="col-lg-4">
        <div class="header-bar text-center py-2 mb-2 rounded-1">My Race</div>
        <div class="content-block p-3 rounded-1 bg-white border">
            <!-- Active race overview or quick action toggles -->
        </div>
    </div>
</div>

