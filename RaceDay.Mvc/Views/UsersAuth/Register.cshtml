@model RaceDay.Mvc.Models.RegisterView

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid min-vh-100">
    <div class="row min-vh-100 justify-content-center align-items-center bg-light">

        <div class="col-12 col-sm-10 col-md-8 col-lg-5">

            <div class="card border-0 shadow-sm p-4 p-sm-5 my-4">

                <div class="text-center mb-4">
                    <h2 class="fw-bold">Get Started</h2>
                    <p class="text-muted small">
                        Create your account to access RaceDay.
                    </p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger small p-2 mb-3">
                </div>

                <form asp-controller="UsersAuth"
                      asp-action="Register"
                      method="post">

                    @Html.AntiForgeryToken()

                    <!-- First Name and Surname -->
                    <div class="row g-3 mb-3">

                        <div class="col-12 col-sm-6">
                            <label asp-for="FirstName"
                                   class="form-label text-muted small fw-semibold">
                                First name
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control form-control-lg"
                                   placeholder="Your name" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="Surname"
                                   class="form-label text-muted small fw-semibold">
                                Surname
                            </label>

                            <input asp-for="Surname"
                                   class="form-control form-control-lg"
                                   placeholder="Your surname" />

                            <span asp-validation-for="Surname"
                                  class="text-danger small">
                            </span>
                        </div>

                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email"
                               class="form-label text-muted small fw-semibold">
                            Email address
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control form-control-lg"
                               placeholder="name@example.com"
                               autocomplete="username" />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>
                    </div>

                    <!-- Phone and Date of Birth -->
                    <div class="row g-3 mb-3">

                        <div class="col-12 col-sm-6">
                            <label asp-for="PhoneNumber"
                                   class="form-label text-muted small fw-semibold">
                                Phone number
                            </label>

                            <input asp-for="PhoneNumber"
                                   type="tel"
                                   class="form-control form-control-lg"
                                   placeholder="+27 123 4567" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="DateOfBirth"
                                   class="form-label text-muted small fw-semibold">
                                Date of birth
                            </label>

                            <input asp-for="DateOfBirth"
                                   type="date"
                                   class="form-control form-control-lg"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />

                            <span asp-validation-for="DateOfBirth"
                                  class="text-danger small">
                            </span>
                        </div>

                    </div>

                    <!-- Account Type -->
                    <div class="mb-3">
                        <label asp-for="Role"
                               class="form-label text-muted small fw-semibold">
                            Account type
                        </label>

                        <select asp-for="Role"
                                class="form-select form-select-lg">

                            <option value="Participant">
                                Participant
                            </option>

                            <option value="Organiser">
                                Organiser
                            </option>

                        </select>

                        <span asp-validation-for="Role"
                              class="text-danger small">
                        </span>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label asp-for="Password"
                               class="form-label text-muted small fw-semibold">
                            Password
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control form-control-lg"
                               placeholder="Create a password"
                               autocomplete="new-password" />

                        <span asp-validation-for="Password"
                              class="text-danger small">
                        </span>

                        <div class="form-text">
                            Password must be at least 8 characters.
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword"
                               class="form-label text-muted small fw-semibold">
                            Confirm password
                        </label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control form-control-lg"
                               placeholder="Confirm your password"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small">
                        </span>
                    </div>

                    <!-- Terms -->
                    <div class="form-check mb-4">
                        <input class="form-check-input"
                               type="checkbox"
                               id="terms"
                               required />

                        <label class="form-check-label text-muted small"
                               for="terms">

                            I agree to the
                            <a href="#" class="text-decoration-none fw-semibold">
                                Terms of Service
                            </a>
                            and
                            <a href="#" class="text-decoration-none fw-semibold">
                                Privacy Policy
                            </a>.

                        </label>
                    </div>

                    <!-- Submit -->
                    <button type="submit"
                            class="btn btn-primary btn-lg w-100 mb-3">
                        Create account
                    </button>

                </form>

                <!-- Login -->
                <div class="mt-4 text-center">
                    <p class="text-muted small mb-0">

                        Already have an account?

                        <a asp-controller="UsersAuth"
                           asp-action="Login"
                           class="text-decoration-none fw-semibold">
                            Sign in
                        </a>

                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
