@model RaceDay.Mvc.Models.LoginView
@{
    ViewData["Title"] = "Login";
}

<div class="container-fluid vh-100">
    <div class="row h-100 justify-content-center align-items-center bg-light">
        <div class="col-12 col-sm-8 col-md-6 col-lg-4">
            <!-- Login Card Wrap -->
            <div class="card border-0 shadow-sm p-4 p-sm-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold">Welcome Back</h2>
                    <p class="text-muted small">Please enter your details to sign in</p>
                </div>
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <form asp-controller="UsersAuth" asp-action="Login" method="post">
                    <!-- Email field -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-muted small fw-semibold">Email address</label>
                        <input asp-for="Email" type="email" class="form-control form-control-lg" placeholder="your email" required autocomplete="Email">
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <!-- UserName field -->
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label text-muted small fw-semibold">Username</label>
                        <input asp-for="Username" type="email" class="form-control form-control-lg" placeholder="name@example.com" required autocomplete="username">
                        <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Password field -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label text-muted small fw-semibold">Password</label>
                        <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="••••••••" required autocomplete="current-password">
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Utilities -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" type="checkbox">
                            <label asp-for="RememberMe" class="form-check-label text-muted small">Remember me</label>
                        </div>
                        <a href="#" class="text-decoration-none small fw-semibold">Forgot password?</a>
                    </div>

                    <!-- Action Buttons -->
                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">Sign in</button>
                    <button type="button" class="btn btn-outline-secondary btn-lg w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-google"></i> Sign in with Google
                    </button>
                </form>

                <!-- Navigation link -->
                <div class="mt-4 text-center">
                    <p class="text-muted small mb-0">
                        Don't have an account?
                        <a href="@Url.Action("Register", "UsersAuth")" class="text-decoration-none fw-semibold">Sign up</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}