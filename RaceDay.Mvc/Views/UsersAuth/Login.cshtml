@model RaceDay.Mvc.Models.LoginView

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid min-vh-100">
    <div class="row min-vh-100 justify-content-center align-items-center bg-light">
        <div class="col-12 col-sm-8 col-md-6 col-lg-4">

            <div class="card border-0 shadow-sm p-4 p-sm-5">

                <div class="text-center mb-4">
                    <h2 class="fw-bold">Welcome Back</h2>
                    <p class="text-muted small">
                        Please enter your details to sign in.
                    </p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3">
                </div>

                <form asp-controller="UsersAuth"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="returnUrl"
                           value="@Context.Request.Query["returnUrl"]" />

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email"
                               class="form-label text-muted small fw-semibold">
                            Email address
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control form-control-lg"
                               placeholder="name@example.com"
                               autocomplete="username"
                               required />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label asp-for="Password"
                               class="form-label text-muted small fw-semibold">
                            Password
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control form-control-lg"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />

                        <span asp-validation-for="Password"
                              class="text-danger small">
                        </span>
                    </div>

                    <!-- Remember Me -->
                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div class="form-check">
                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <label asp-for="RememberMe"
                                   class="form-check-label text-muted small">
                                Remember me
                            </label>
                        </div>

                    </div>

                    <!-- Submit -->
                    <button type="submit"
                            class="btn btn-primary btn-lg w-100 mb-3">
                        Sign in
                    </button>

                </form>

                <!-- Register -->
                <div class="mt-4 text-center">
                    <p class="text-muted small mb-0">
                        Don't have an account?

                        <a asp-controller="UsersAuth"
                           asp-action="Register"
                           class="text-decoration-none fw-semibold">
                            Sign up
                        </a>
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
