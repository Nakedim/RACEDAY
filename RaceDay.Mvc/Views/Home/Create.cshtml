@model RaceDay.Mvc.Models.RaceModel

@{
    ViewData["Title"] = "Create a Race";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white py-3">
                    <h2 class="h5 mb-0">
                        <i class="bi bi-flag-fill me-2"></i>
                        Create a New Race
                    </h2>
                </div>

                <div class="card-body p-4">
                    <form asp-controller="Races"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger small">
                        </div>

                        <!-- Event -->
                        <div class="mb-3">
                            <label asp-for="EventID" class="form-label fw-bold">
                                Select Event
                            </label>
                            <select asp-for="EventID"
                                    class="form-select"
                                    asp-items="@(ViewBag.RaceEvents as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>())">
                                <option value="">-- Choose an Event --</option>
                            </select>
                            <span asp-validation-for="EventID" class="text-danger small"></span>
                        </div>

                        <!-- Race Name -->
                        <div class="mb-3">
                            <label asp-for="RaceName" class="form-label fw-bold">
                                Race Name
                            </label>
                            <input asp-for="RaceName" class="form-control" placeholder="e.g., 10km Fun Run" />
                            <span asp-validation-for="RaceName" class="text-danger small"></span>
                        </div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label asp-for="CategoryID" class="form-label fw-bold">
                                Racing Category
                            </label>
                            <select asp-for="CategoryID"
                                    class="form-select"
                                    asp-items="@(ViewBag.Categories as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>())">
                                <option value="">-- Choose a Category --</option>
                            </select>
                            <span asp-validation-for="CategoryID" class="text-danger small"></span>
                        </div>

                        <!-- Start Time -->
                        <div class="mb-3">
                            <label asp-for="StartTime" class="form-label fw-bold">
                                Start Date &amp; Time
                            </label>
                            <input asp-for="StartTime" type="datetime-local" class="form-control" />
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                        </div>

                        <!-- Distance -->
                        <div class="mb-3">
                            <label asp-for="Distance" class="form-label fw-bold">
                                Distance (km)
                            </label>
                            <input asp-for="Distance" type="number" step="0.1" class="form-control" placeholder="e.g., 21.1" />
                            <span asp-validation-for="Distance" class="text-danger small"></span>
                        </div>

                        <!-- Location -->
                        <div class="mb-3">
                            <label asp-for="Location" class="form-label fw-bold">
                                Location
                            </label>
                            <input asp-for="Location" class="form-control" placeholder="e.g., Germiston Lake Main Gate" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-controller="Races"
                               asp-action="Index"
                               class="btn btn-outline-secondary btn-sm">
                                Cancel
                            </a>

                            <button type="submit" class="btn btn-success px-4">
                                Create Race
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}