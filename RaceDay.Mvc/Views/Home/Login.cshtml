@{
    ViewData["Title"] = "Login";
}

@model IEnumerable<RaceDay.Mvc.Models.LoginView> 

<div class="container-fluid vh-100">
    <div class="row h-100 justify-content-center align-items-center bg-light">
        <div class="col-12 col-sm-8 col-md-6 col-lg-4">

            <!-- Login Card Wrap -->
            <div class="card border-0 shadow-sm p-4 p-sm-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold">Welcome Back</h2>
                    <p class="text-muted small">Please enter your details to sign in</p>
                </div>

                <form method="post">
                    <!-- Email field -->
                    <div class="mb-3">
                        <label for="email" class="form-label text-muted small fw-semibold">Email address</label>
                        <input type="email" class="form-control form-control-lg" id="email" placeholder="name@example.com" required autocomplete="username">
                    </div>

                    <!-- Password field -->
                    <div class="mb-3">
                        <label for="password" class="form-label text-muted small fw-semibold">Password</label>
                        <input type="password" class="form-control form-control-lg" id="password" placeholder="••••••••" required autocomplete="current-password">
                    </div>

                    <!-- Utilities -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberMe">
                            <label class="form-check-label text-muted small" for="rememberMe">Remember me</label>
                        </div>
                        <a href="#" class="text-decoration-none small fw-semibold">Forgot password?</a>
                    </div>

                    <!-- Action Buttons -->
                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">Sign in</button>
                    <button type="button" class="btn btn-outline-secondary btn-lg w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-google"></i> Sign in with Google
                    </button>
                </form>

                <!-- Navigation link -->
                <div class="mt-4 text-center">
                    <p class="text-muted small mb-0">Don't have an account? <a href="/Account/Register" class="text-decoration-none fw-semibold">Sign up</a></p>
                </div>
            </div>

        </div>
    </div>
</div>
