@{
    ViewData["Title"] = "Create an Account";
}

<!-- Unified Standalone Layout Wrapper -->
<div class="container-fluid vh-100">
    <div class="row h-100 justify-content-center align-items-center bg-light">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">

            <!-- Register Card Wrap -->
            <div class="card border-0 shadow-sm p-4 p-sm-5 my-4">
                <div class="text-center mb-4">
                    <h2 class="fw-bold">Get Started</h2>
                    <p class="text-muted small">Create your account to access the dashboard</p>
                </div>

                <form method="post">
                    <!-- Row for First and Last Name fields -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label for="firstName" class="form-label text-muted small fw-semibold">First name</label>
                            <input type="text" class="form-control form-control-lg" id="firstName" placeholder="John" required>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label for="lastName" class="form-label text-muted small fw-semibold">Last name</label>
                            <input type="text" class="form-control form-control-lg" id="lastName" placeholder="Doe" required>
                        </div>
                    </div>

                    <!-- Email field -->
                    <div class="mb-3">
                        <label for="email" class="form-label text-muted small fw-semibold">Email address</label>
                        <input type="email" class="form-control form-control-lg" id="email" placeholder="name@example.com" required autocomplete="username">
                    </div>

                    <!-- Password field -->
                    <div class="mb-3">
                        <label for="password" class="form-label text-muted small fw-semibold">Password</label>
                        <input type="password" class="form-control form-control-lg" id="password" placeholder="••••••••" required autocomplete="new-password">
                        <div class="form-text text-muted small">Must be at least 8 characters long.</div>
                    </div>

                    <!-- Confirm Password field -->
                    <div class="mb-4">
                        <label for="confirmPassword" class="form-label text-muted small fw-semibold">Confirm password</label>
                        <input type="password" class="form-control form-control-lg" id="confirmPassword" placeholder="••••••••" required autocomplete="new-password">
                    </div>

                    <!-- Terms and Conditions check -->
                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="terms" required>
                        <label class="form-check-label text-muted small" for="terms">
                            I agree to the <a href="#" class="text-decoration-none fw-semibold">Terms of Service</a> and <a href="#" class="text-decoration-none fw-semibold">Privacy Policy</a>
                        </label>
                    </div>

                    <!-- Action Buttons -->
                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">Create account</button>
                    <button type="button" class="btn btn-outline-secondary btn-lg w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-google"></i> Sign up with Google
                    </button>
                </form>

                <!-- Navigation link back to Login -->
                <div class="mt-4 text-center">
                    <p class="text-muted small mb-0">Already have an account? <a href="/Account/Login" class="text-decoration-none fw-semibold">Sign in</a></p>
                </div>
            </div>

            <!-- Footer Resources Component Links -->
            <div class="text-center mt-3 mb-4">
                <p class="text-muted small">Learn about <a href="https://learn.microsoft.com/aspnet/core" target="_blank" rel="noopener">building Web apps with ASP.NET Core</a>.</p>
            </div>

        </div>
    </div>
</div>
