@{
    ViewData["Title"] = "Welcome to Raceday";
}

<style>
    /* Custom Color Variables & Utility Overrides */
    .bg-custom-dark {
        background-color: #1e293b !important; /* Slate 800 */
    }
    .bg-custom-gray {
        background-color: #f1f5f9 !important; /* Slate 100 */
    }
    .text-sm {
        font-size: 0.875rem !important;
    }
    
    /* Layout Sizing Fixes */
    .min-height-hero {
        min-height: 260px;
    }
    .min-height-card {
        min-height: 120px;
    }

    /* Micro-interactions & Smooth Hover Animations */
    .card-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out, background-color 0.2s ease-in-out;
    }
    .card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05) !important;
        background-color: #e2e8f0 !important; /* Slate 200 on hover */
    }

</style>
<div class="container-fluid p-0">
    <div class="row g-0">
        
        <!-- ================= SIDEBAR CONTAINER (Left Side) ================= -->
        <aside class="col-12 col-md-3 col-lg-2 bg-custom-dark text-white p-3 border-end border-secondary min-vh-100">
            <div class="mb-4">
                <h2 class="h4 fw-bold mb-0 text-white">Raceday</h2>
            </div>

            <!-- Participant Card -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="bg-white text-dark rounded p-3 mb-3 shadow-sm">
                    <h6 class="fw-bold">Welcome!</h6>

                    <p class="text-muted small">
                        @User.Identity.Name
                    </p>

                    @if (User.IsInRole("Organiser"))
                    {
                        <a asp-controller="Home"
                           asp-action="OrganiserDash"
                           class="btn btn-primary btn-sm w-100 mb-2">
                            Organiser Dashboard
                        </a>
                    }
                    else if (User.IsInRole("Participant"))
                    {
                        <a asp-controller="Home"
                           asp-action="ParticipantDash"
                           class="btn btn-primary btn-sm w-100 mb-2">
                            Participant Dashboard
                        </a>
                    }

                    <form asp-controller="UsersAuth"
                          asp-action="Logout"
                          method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="btn btn-outline-danger btn-sm w-100">
                            Sign Out
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="bg-white text-dark rounded p-3 mb-3 shadow-sm">
                    <h6 class="fw-bold">Are you a participant?</h6>

                    <p class="text-muted small">
                        Sign up to manage and track your race statistics.
                    </p>

                    <a asp-controller="UsersAuth"
                       asp-action="Register"
                       asp-route-role="Participant"
                       class="btn btn-primary btn-sm w-100 mb-2">
                        Create an Account
                    </a>

                    <a asp-controller="UsersAuth"
                       asp-action="Login"
                       class="small">
                        Already have an account? Sign in
                    </a>
                </div>

                <div class="bg-white text-dark rounded p-3 mb-3 shadow-sm">
                    <h6 class="fw-bold">Are you an event organiser?</h6>

                    <p class="text-muted small">
                        Sign up to manage your events and races.
                    </p>

                    <a asp-controller="UsersAuth"
                       asp-action="Register"
                       asp-route-role="Organiser"
                       class="btn btn-primary btn-sm w-100 mb-2">
                        Create an Account
                    </a>

                    <a asp-controller="UsersAuth"
                       asp-action="Login"
                       class="small">
                        Already have an account? Sign in
                    </a>
                </div>
            }

        
        </aside>

        <!-- ================= MAIN CONTENT AREA (Right Side) ================= -->
        <main class="col-12 col-md-9 col-lg-10 bg-light d-flex flex-column min-vh-100">

            <div class="p-4 flex-grow-1">
                
                <!-- Hero Slider Section -->
                <section class="bg-custom-gray text-dark rounded p-5 mb-4 shadow-sm border text-center d-flex align-items-center justify-content-center min-height-hero">
                    <div>
                        <h1 class="h3 fw-semibold mb-2">Slideshow of Events, important dates, campus activities and general announcements</h1>
                        <p class="text-muted mb-0">Dynamic slider component placeholder</p>
                    </div>
                </section>

                <!-- 6-Card Feature Grid -->
                <section class="row g-4">
                    <div class="col-12 col-sm-6 col-lg-4">
                        <a href="@Url.Action("Index", "PastRaces")" class="card h-100 bg-custom-gray border text-decoration-none text-dark card-hover shadow-sm">
                            <div class="card-body d-flex align-items-center justify-content-center min-height-card">
                                <h5 class="card-title fw-medium m-0 text-center">Past Races</h5>
                            </div>
                        </a>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <a href="@Url.Action("Index", "Organisers")" class="card h-100 bg-custom-gray border text-decoration-none text-dark card-hover shadow-sm">
                            <div class="card-body d-flex align-items-center justify-content-center min-height-card">
                                <h5 class="card-title fw-medium m-0 text-center">Organisers</h5>
                            </div>
                        </a>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <a href="@Url.Action("Gallery", "Events")" class="card h-100 bg-custom-gray border text-decoration-none text-dark card-hover shadow-sm">
                            <div class="card-body d-flex align-items-center justify-content-center min-height-card">
                                <h5 class="card-title fw-medium m-0 text-center">Events Gallery</h5>
                            </div>
                        </a>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <a href="@Url.Action("Index", "Leaderboard")" class="card h-100 bg-custom-gray border text-decoration-none text-dark card-hover shadow-sm">
                            <div class="card-body d-flex align-items-center justify-content-center min-height-card">
                                <h5 class="card-title fw-medium m-0 text-center">Leaderboard</h5>
                            </div>
                        </a>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <a href="@Url.Action("Upcoming", "Events")" class="card h-100 bg-custom-gray border text-decoration-none text-dark card-hover shadow-sm">
                            <div class="card-body d-flex align-items-center justify-content-center min-height-card">
                                <h5 class="card-title fw-medium m-0 text-center">Upcoming Events</h5>
                            </div>
                        </a>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <a href="@Url.Action("Classmates", "Account")" class="card h-100 bg-custom-gray border text-decoration-none text-dark card-hover shadow-sm">
                            <div class="card-body d-flex align-items-center justify-content-center min-height-card">
                                <h5 class="card-title fw-medium m-0 text-center">My Classmates</h5>
                            </div>
                        </a>
                    </div>
                </section>

            </div>

 
        </main>
        
    </div>
</div>