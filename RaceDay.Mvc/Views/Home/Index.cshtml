@{
    ViewData["Title"] = "Welcome to Raceday";
}
@*Views/Auth/Register.cshtml*@
@model RegisterView

<style>

</style>
<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light">

    <!-- Row that limits the max expansion to keep cards centered -->
    <div class="row w-100 justify-content-center" style="max-width: 1100px;">

        <!-- Left Column (takes half of the row area) -->
        <div class="col-md-6 d-flex justify-content-center p-3">
            <div class="card p-5 text-center shadow-sm custom-wide-card">
                <h2 class="fw-bold mb-3">Are you the participant</h2>
                <p class="text-muted small mb-4">Join us today to manage and track your race days seamlessly.</p>
                <button asp-controller="UsersAuthController" asp-action="Login" class="btn btn-primary py-2 w-100 mb-3 fw-semibold">Create an Account</button>
                <span class="text-muted small">Already have an account? <a href="#" class="text-decoration-none">Sign in</a></span>
            </div>
        </div>

        <!-- Right Column (takes half of the row area) -->
        <div class="col-md-6 d-flex justify-content-center p-3">
            <div class="card p-5 text-center shadow-sm custom-wide-card">
                <h2 class="fw-bold mb-3">Are you the event organiser?</h2>
                <p class="text-muted small mb-4">Sign up to manage your events and races</p>

                <button asp-controller="UsersAuthController" asp-action="Register" class="btn btn-primary py-2 w-100 mb-3 fw-semibold">Create an Account</button>
                <span class="text-muted small">Already have an account? <a href="#" class="text-decoration-none">Sign in</a></span>
            </div>
        </div>

    </div>
</div>





             





            <!-- Footer Resources Component Links -->
            <div class="text-center mt-3 mb-4">
                <p class="text-muted small">Learn about <a href="https://learn.microsoft.com/aspnet/core" target="_blank" rel="noopener">building Web apps with ASP.NET Core</a>.</p>
            </div>

        </div>
    </div>
</div>
