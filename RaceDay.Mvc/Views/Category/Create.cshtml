@model RaceDay.Mvc.Models.CategoryModel

@{
    ViewData["Title"] = "Create Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        :root {
            --primary-lime: #7cb305;
            --dark-lime: #5b8c00;
        }

        .form-container {
            background-color: white;
            border: 1px solid #dee2e6;
            border-radius: 4px;
        }

        .btn-lime {
            background-color: var(--primary-lime);
            color: white;
            border: none;
            transition: background-color 0.2s ease;
        }

            .btn-lime:hover {
                background-color: var(--dark-lime);
                color: white;
            }
    </style>
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <!-- Back navigation link -->
            <div class="mb-3">
                <a asp-controller="Home" asp-action="OrganiserDash" class="text-muted text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Back to Dashboard
                </a>
            </div>

            <div class="form-container p-4 shadow-sm">
                <h2 class="fw-bold mb-3 fs-4">Create Event Category</h2>
                <p class="text-muted mb-4">Set up a new target category or class tier for your competitors.</p>

                <form asp-controller="Categories" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Global Error Summary Alert Block -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Category Name Field -->
                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label fw-medium">Category Name</label>
                        <input asp-for="CategoryName" class="form-control" placeholder="e.g., Veteran Men, Elite Women, Under 23" />
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <!-- Optional: Category Description Field -->
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-medium">Description (Optional)</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Define restrictions, age limits, or technical criteria..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Action Control Buttons -->
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-controller="Home" asp-action="OrganiserDash" class="btn btn-outline-secondary px-4">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-lime px-4">
                            Save Category
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <!-- Built-in jQuery Validation scripts for instant client-side error checking -->
    <partial name="_ValidationScriptsPartial" />
}
