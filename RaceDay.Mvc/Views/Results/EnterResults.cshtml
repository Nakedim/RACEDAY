@model RaceDay.Mvc.Models.EnterResultsModel

@{
    ViewData["Title"] = "Record Race Result";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5" style="max-width: 650px;">
    <div class="card shadow-sm border-0">

        <!-- Header -->
        <div class="card-header bg-dark text-white py-3">
            <h2 class="h5 mb-0">
                <i class="bi bi-trophy-fill text-warning me-2"></i>
                Record Race Result
            </h2>
        </div>

        <div class="card-body p-4">
            <p class="text-muted small mb-4">
                Enter the official finishing position and time for a race participant.
            </p>

            <form asp-controller="RaceResults"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger small">
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                <!-- Race Selection -->
                <div class="mb-3">
                    <label asp-for="RaceID" class="form-label fw-bold">
                        Select Race
                    </label>
                    <select asp-for="RaceID"
                            class="form-select"
                            asp-items="@(ViewBag.Races as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>())">
                        <option value="">-- Choose a Race --</option>
                    </select>
                    <span asp-validation-for="RaceID" class="text-danger small"></span>
                </div>

                <!-- Participant ID -->
                <div class="mb-3">
                    <label asp-for="ParticipantID" class="form-label fw-bold">
                        Participant ID
                    </label>
                    <input asp-for="ParticipantID" type="number" min="1" class="form-control" placeholder="e.g. 12" />
                    <span asp-validation-for="ParticipantID" class="text-danger small"></span>
                </div>

                <div class="row g-3">
                    <!-- Position -->
                    <div class="col-md-6">
                        <label asp-for="Position" class="form-label fw-bold">
                            Finishing Position
                        </label>
                        <input asp-for="Position" type="number" min="1" class="form-control" placeholder="e.g. 1" />
                        <span asp-validation-for="Position" class="text-danger small"></span>
                    </div>

                    <!-- Finish Time -->
                    <div class="col-md-6">
                        <label asp-for="FinishTime" class="form-label fw-bold">
                            Finish Time (HH:MM:SS)
                        </label>
                        <input asp-for="FinishTime" type="time" step="1" class="form-control" />
                        <span asp-validation-for="FinishTime" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-controller="RaceResults"
                       asp-action="Index"
                       class="btn btn-outline-secondary btn-sm px-3">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-circle me-1"></i> Save Result
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
