@model RaceDay.Mvc.Models.EnterResultsModel
@{
    ViewData["Title"] = "Record Race Result";
}
<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h2 class="h5 mb-0"><i class="bi bi-stopwatch me-2"></i>Record Race Result</h2>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small mb-4">Log the official finishing position and timestamp for a race participant.</p>

                    <form asp-action="CreateResult" method="post" id="CreateResultForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Race Dropdown Selection -->
                        <div class="mb-3">
                            <label asp-for="RaceID" class="form-label fw-bold">Select Race</label>
                            <select asp-for="RaceID" class="form-select" asp-items="ViewBag.RacesList">
                                <option value="">-- Choose a Race --</option>
                            </select>
                            <span asp-validation-for="RaceID" class="text-danger small"></span>
                        </div>

                        <!-- Participant Dropdown Selection -->
                        <div class="mb-3">
                            <label asp-for="ParticipantID" class="form-label fw-bold">Select Participant</label>
                            <select asp-for="ParticipantID" class="form-select" asp-items="ViewBag.ParticipantsList">
                                <option value="">-- Choose a Participant --</option>
                            </select>
                            <span asp-validation-for="ParticipantID" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <!-- Finishing Position -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Position" class="form-label fw-bold">Finishing Position</label>
                                <input asp-for="Position" type="number" min="1" class="form-control" placeholder="e.g. 1" />
                                <span asp-validation-for="Position" class="text-danger small"></span>
                            </div>

                            <!-- Finish Time Timestamp -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="FinishTime" class="form-label fw-bold">Finish Time & Date</label>
                                <input asp-for="FinishTime" type="datetime-local" class="form-control" />
                                <span asp-validation-for="FinishTime" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Form Submission Controls -->
                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Results</a>
                            <button type="submit" class="btn btn-dark px-4 shadow-sm">Save Official Result</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}