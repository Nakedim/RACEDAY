@model RaceDay.Mvc.Models.EnterResultsModel
@{
    ViewData["Title"] = "Race Results";

}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="h5 mb-0">@ViewData["Title"]</h2>
                </div>

                <div class="card-body">
                    <form asp-action="@(Model?.ResultID == 0 ? "Create" : "Edit")" method="post">

                        @* Validation Summary *@
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @* Hidden field for Key ID during Edits *@
                        @if (Model?.ResultID > 0)
                        {
                            <input type="hidden" asp-for="ResultID" />
                        }

                        @* Race Selection dropdown *@
                        <div class="mb-3">
                            <label asp-for="RaceID" class="form-label">Race</label>
                            <select asp-for="RaceID" class="form-select" asp-items="ViewBag.Races">
                                <option value="">-- Select Race --</option>
                            </select>
                            <span asp-validation-for="RaceID" class="text-danger small"></span>
                        </div>

                        @* Participant Selection dropdown *@
                        <div class="mb-3">
                            <label asp-for="ParticipantID" class="form-label">Participant</label>
                            <select asp-for="ParticipantID" class="form-select" asp-items="ViewBag.Participants">
                                <option value="">-- Select Participant --</option>
                            </select>
                            <span asp-validation-for="ParticipantID" class="text-danger small"></span>
                        </div>

                        @* Finish Time input *@
                        <div class="mb-3">
                            <label asp-for="FinishTime" class="form-label">Finish Time</label>
                            <input asp-for="FinishTime" type="datetime-local" class="form-control" />
                            <span asp-validation-for="FinishTime" class="text-danger small"></span>
                        </div>

                        @* Position input *@
                        <div class="mb-3">
                            <label asp-for="Position" class="form-label">Finishing Position</label>
                            <input asp-for="Position" type="number" min="1" class="form-control" placeholder="e.g. 1" />
                            <span asp-validation-for="Position" class="text-danger small"></span>
                        </div>

                        @* Form Actions *@
                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                            <button type="submit" class="btn btn-primary px-4">Save Result</button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}