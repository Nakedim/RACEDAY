@model IEnumerable<RaceDay.Mvc.Models.RaceResultModel>
@{
    ViewData["Title"] = "Race Results";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="fw-bold mb-0">Race Results</h2>
                <a asp-controller="Participant" asp-action="Dashboard" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header text-white fw-semibold" style="background-color: #7cb305;">
                    Official Race Results
                </div>

                <div class="card-body p-0">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Position</th>
                                        <th>Race ID</th>
                                        <th>Participant ID</th>
                                        <th>Finish Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.OrderBy(r => r.Position))
                                    {
                                        <tr>
                                            <td class="fw-bold">@item.Position</td>
                                            <td>@item.RaceID</td>
                                            <td>@item.ParticipantID</td>
                                            <td>@item.FinishTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            No race results available yet.
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>
