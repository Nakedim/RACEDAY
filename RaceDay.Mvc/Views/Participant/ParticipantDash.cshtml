@{
    ViewData["Title"] = "Participant Dashboard";
}
 <style>
   
    </style>
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar Navigation -->
        <nav class="col-md-3 col-lg-2 px-0 sidebar d-flex flex-column">
            <div class="p-3">
                <h4 class="fw-bold mb-0">Raceday</h4>
                <p class="small opacity-75 mt-4 mb-4">Participant dashboard</p>
            </div>
            
            <div class="nav flex-column w-100">
                <a href="#" class="nav-link py-2 px-3">Manage Entries</a>
                <a href="#" class="nav-link py-2 px-3">View Events</a>
                <a href="#" class="nav-link py-2 px-3">View Categories</a>
                <a href="#" class="nav-link py-2 px-3">View Race</a>
                <a asp-controller="UsersAuth" asp-action="Logout" class="nav-link py-2 px-3 mt-4">logout</a>
            </div>
        </nav>
        <form asp-controller="UsersAuth" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-danger btn-lg shadow-sm">
                Log Out
            </button>
        </form>
        <!-- Main Content Area -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-0 d-flex flex-column justify-content-between min-vh-100">
            
            <!-- Top Navbar & Greeting -->
            <div class="px-4 pt-3">
                <div class="d-flex justify-content-end gap-3 fs-4 mb-2">
                    <i class="bi bi-envelope-fill cursor-pointer"></i>
                    <i class="bi bi-bell-fill cursor-pointer"></i>
                    <i class="bi bi-person-circle cursor-pointer"></i>
                    <i class="bi bi-gear-fill cursor-pointer"></i>
                </div>
                
                <div class="text-center my-3">
                    <div class="text-muted small">Hi, Marlin</div>
                    <h2 class="fw-bold">Your Dashboard</h2>
                </div>

                <!-- Previous Results Banner -->
                <div class="header-bar text-center py-2 mb-4 rounded-1">
                    My previous Results
                </div>

                <!-- Metric Cards Grid -->
                <div class="row g-3 text-center mb-4">
                    <div class="col-6 col-md-4 col-lg-2-4 width-custom">
                        <div class="metric-box p-2 rounded-1">Position</div>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2-4">
                        <div class="metric-box p-2 rounded-1">Finish Time</div>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2-4">
                        <div class="metric-box p-2 rounded-1">Race Date</div>
                    </div>
                    <div class="col-6 col-md-6 col-lg-2-4">
                        <div class="metric-box p-2 rounded-1">Personal Record</div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-2-4">
                        <div  class="metric-box p-2 rounded-1">Points</div>
                    </div>
                </div>

                <!-- Content Sections -->
                <div class="row g-4 mb-5">
                    <div class="col-lg-4">
                        <div class="header-bar text-center py-2 mb-2 rounded-1">MY Entries</div>
                        <div class="content-block rounded-1"></div>
                    </div>
                    <div class="col-lg-4">
                        <div class="header-bar text-center py-2 mb-2 rounded-1">Race results</div>
                        <div class="content-block rounded-1"></div>
                    </div>
                    <div class="col-lg-4">
                        <div class="header-bar text-center py-2 mb-2 rounded-1">Leaderboard</div>
                        <div class="content-block rounded-1"></div>
                    </div>
                </div>
            </div>

            <!-- Decorative Bottom Banner -->
            <div class="footer-banner w-100 mt-auto"></div>
        </main>
    </div>
</div>


