@{
    ViewData["Title"] = "Participant Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .participant-sidebar {
            background-color: #e6e8eb;
            min-height: 100vh;
        }

            .participant-sidebar .nav-link {
                color: #fff;
                background-color: #7cb305;
                margin-bottom: 8px;
                border-radius: 5px;
                padding: 12px 15px;
            }

                .participant-sidebar .nav-link:hover {
                    background-color: #5b8c00;
                    color: #fff;
                }

        .header-bar {
            background-color: #7cb305;
            color: white;
            font-weight: 600;
        }

        .metric-box {
            background-color: white;
            border: 1px solid #dee2e6;
            min-height: 100px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 8px;
            font-weight: 600;
        }

        .content-block {
            background-color: white;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            min-height: 180px;
            padding: 20px;
        }

        .footer-banner {
            height: 12px;
            background-color: #7cb305;
        }

        .dashboard-icon {
            font-size: 22px;
            color: #6c757d;
        }
    </style>
}

<div class="container-fluid">
    <div class="row">

        <!-- Sidebar -->
        <nav class="col-md-3 col-lg-2 px-3 py-4 participant-sidebar">

            <div class="mb-4">
                <h4 class="fw-bold">RaceDay</h4>

                <p class="small text-muted">
                    Participant Dashboard
                </p>
            </div>

            <div class="nav flex-column">

                <a asp-controller="RaceEntries"
                   asp-action="CreateEntries"
                   class="nav-link">
                    <i class="bi bi-card-checklist me-2"></i>
                    Manage Entries
                </a>

                <a asp-controller="Home"
                   asp-action="Events"
                   class="nav-link">
                    <i class="bi bi-calendar-event me-2"></i>
                    View Events
                </a>

                <a asp-controller="Home"
                   asp-action="Races"
                   class="nav-link">
                    <i class="bi bi-flag me-2"></i>
                    View Races
                </a>

                <a asp-controller="Home"
                   asp-action="Results"
                   class="nav-link">
                    <i class="bi bi-trophy me-2"></i>
                    Race Results
                </a>

                <form asp-controller="UsersAuth"
                      asp-action="Logout"
                      method="post"
                      class="mt-4">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger w-100">

                        <i class="bi bi-box-arrow-right me-2"></i>
                        Logout

                    </button>

                </form>

            </div>
        </nav>

        <!-- Main Content -->
        <main class="col-md-9 col-lg-10 px-4 py-3 d-flex flex-column min-vh-100">

            <!-- Top Navigation -->
            <div class="d-flex justify-content-end gap-3 mb-3">

                <i class="bi bi-envelope-fill dashboard-icon"></i>
                <i class="bi bi-bell-fill dashboard-icon"></i>
                <i class="bi bi-person-circle dashboard-icon"></i>
                <i class="bi bi-gear-fill dashboard-icon"></i>

            </div>

            <!-- Greeting -->
            <div class="text-center my-3">

                <div class="text-muted small">
                    Welcome, @User.Identity?.Name
                </div>

                <h2 class="fw-bold">
                    Your Dashboard
                </h2>

            </div>

            <!-- Previous Results -->
            <div class="header-bar text-center py-2 mb-4 rounded-1">
                My Previous Results
            </div>

            <!-- Performance Metrics -->
            <div class="row g-3 text-center mb-4">

                <div class="col-6 col-md-4 col-xl">
                    <div class="metric-box">
                        Position
                    </div>
                </div>

                <div class="col-6 col-md-4 col-xl">
                    <div class="metric-box">
                        Finish Time
                    </div>
                </div>

                <div class="col-6 col-md-4 col-xl">
                    <div class="metric-box">
                        Race Date
                    </div>
                </div>

                <div class="col-6 col-md-6 col-xl">
                    <div class="metric-box">
                        Personal Record
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl">
                    <div class="metric-box">
                        Points
                    </div>
                </div>

            </div>

            <!-- Participant Sections -->
            <div class="row g-4 mb-5">

                <!-- Entries -->
                <div class="col-lg-4">

                    <div class="header-bar text-center py-2 mb-2 rounded-1">
                        My Entries
                    </div>

                    <div class="content-block">

                        <p class="text-muted text-center">
                            Your registered race entries will appear here.
                        </p>

                        <div class="text-center">

                            <a asp-controller="RaceEntries"
                               asp-action="CreateEntries"
                               class="btn btn-success">
                                Manage Entries
                            </a>

                        </div>

                    </div>
                </div>

                <!-- Results -->
                <div class="col-lg-4">

                    <div class="header-bar text-center py-2 mb-2 rounded-1">
                        Race Results
                    </div>

                    <div class="content-block">

                        <p class="text-muted text-center">
                            Your race results will appear here.
                        </p>

                        <div class="text-center">

                            <a asp-controller="Home"
                               asp-action="Results"
                               class="btn btn-success">
                                View Results
                            </a>

                        </div>

                    </div>
                </div>

                <!-- Leaderboard -->
                <div class="col-lg-4">

                    <div class="header-bar text-center py-2 mb-2 rounded-1">
                        Leaderboard
                    </div>

                    <div class="content-block">

                        <p class="text-muted text-center">
                            View race rankings and participant positions.
                        </p>

                        <div class="text-center">

                            <a asp-controller="Home"
                               asp-action="Results"
                               class="btn btn-success">
                                View Rankings
                            </a>

                        </div>

                    </div>
                </div>

            </div>

            <!-- Footer -->
            <div class="footer-banner w-100 mt-auto"></div>

        </main>
    </div>
</div>
